# ==========================================
# BehaviorSim API - Environment Configuration
# ==========================================
# Copy this file to .env and configure local values.
# Do NOT commit real credentials or production secrets.

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME="BehaviorSim API"
API_VERSION=0.1.0

# Base URLs
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Database Connection (Phase 1+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/behaviorsim_dev

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
