# ==============================================================================
# BehaviorSim API - Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local development.
# In production (Render), configure these values in the Render Environment Dashboard.
# NEVER commit production secrets or real credentials to git history.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Mode: 'development', 'testing', or 'production'
# In production, strict validation guards are enforced (HTTPS required, no SQLite/localhost).
APP_ENV=development
APP_NAME="BehaviorSim API"
API_VERSION=0.1.0

# ------------------------------------------------------------------------------
# 2. TARGET DOMAINS & URLS
# ------------------------------------------------------------------------------
# Development defaults:
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Production targets (Configured in Render Dashboard):
# API_BASE_URL=https://api.behaviorsim.vedaangsharma.in
# WEB_BASE_URL=https://behaviorsim.vedaangsharma.in
# OAUTH_REDIRECT_BASE_URL=https://api.behaviorsim.vedaangsharma.in
# CORS_ORIGINS=https://behaviorsim.vedaangsharma.in

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Neon PostgreSQL Connection URL format:
# Format: postgresql+psycopg://USER:PASSWORD@ep-xyz.REGION.aws.neon.tech/neondb?sslmode=require
#
# Production Notes:
# - Neon requires encrypted connections (sslmode=require).
# - The application automatically normalizes postgresql:// and postgres:// to postgresql+psycopg://
#   while preserving all query parameters (e.g. ?sslmode=require).
# - For Render production, store your Neon connection string as a secret variable in Render Dashboard.
# - For local development against Neon, place your connection string in .env (which is git-ignored).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xyz.REGION.aws.neon.tech/neondb?sslmode=require

# Connection pool settings (applies to Neon PostgreSQL / external RDBMS):
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & CREDENTIAL PREFIXES
# ------------------------------------------------------------------------------
API_KEY_PREFIX=bs_live_
SESSION_TOKEN_PREFIX=bs_sess_

# Session & OAuth state cookie lifecycles:
AUTH_SESSION_COOKIE_NAME=behaviorsim_session
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_OAUTH_STATE_COOKIE_NAME=behaviorsim_oauth_state
AUTH_OAUTH_STATE_MAX_AGE_SECONDS=600

# ------------------------------------------------------------------------------
# 5. OAUTH SECRETS (Required for OAuth Login)
# ------------------------------------------------------------------------------
# Register production callback URLs with identity providers:
# - Google: https://api.behaviorsim.vedaangsharma.in/v1/auth/google/callback
# - GitHub: https://api.behaviorsim.vedaangsharma.in/v1/auth/github/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
